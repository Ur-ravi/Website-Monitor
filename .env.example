APP_NAME="Website Monitor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://web.edutechy.in

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u449454529_websitecheck
DB_USERNAME=u449454529_websitecheck
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

ADMIN_NAME="Administrator"
ADMIN_EMAIL="admin@edutechy.in"
ADMIN_PASSWORD="ChangeThisPassword!"

# Optional alerts. Leave blank to disable email alerts.
MONITOR_ALERT_EMAIL=
# Recovery emails are sent when a confirmed DOWN/WARNING website recovers.
MONITOR_ALERT_ON_RECOVERY=true
